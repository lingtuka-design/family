{
  "name": "@family-book/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:apply": "wrangler d1 execute family-storybook --local --file ./schema.sql",
    "db:apply:prod": "wrangler d1 execute family-storybook --remote --file ./schema.sql"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "jose": "^6.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "typescript": "^5.6.2",
    "wrangler": "^3.80.0"
  }
}
